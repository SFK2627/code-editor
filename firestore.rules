rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email == 'sirjr.mcsian@gmail.com';
    }

    function isOwner(studentUid) {
      return isSignedIn() && request.auth.uid == studentUid;
    }

    function currentStudentProfilePath(documentId) {
      return /databases/$(database)/documents/webCodeEditor/$(documentId)/students/$(request.auth.uid);
    }

    function hasCurrentStudentProfile(documentId) {
      return isSignedIn() && exists(currentStudentProfilePath(documentId));
    }

    function currentStudentProfile(documentId) {
      return get(currentStudentProfilePath(documentId)).data;
    }

    function ownsComplianceRecord(documentId, recordId) {
      return isSignedIn() && (
        resource.data.studentAuthEmail == request.auth.token.email
        || (
          hasCurrentStudentProfile(documentId)
          && (
            currentStudentProfile(documentId).studentIdNormalized == recordId
            || currentStudentProfile(documentId).studentIdNormalized == resource.data.studentIdNormalized
            || currentStudentProfile(documentId).studentId == resource.data.studentIdOriginal
            || currentStudentProfile(documentId).studentId == resource.data.studentId
          )
        )
      );
    }

    // STEP 279 — Code Inbox ownership.
    // Student Auth emails are generated from Student ID:
    // sid-25000985@students.mcsian.app
    // Recovery profiles such as sid-25000985-r1@... are also accepted.
    // This avoids depending on studentRoster/authUid for receiving code.
    function ownsCodeInboxKey(studentIdAuthKey) {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches(
          '^sid-' + studentIdAuthKey + '(-r[0-9]+)?@students[.]mcsian[.]app$'
        );
    }

    function ownsStudentLoginRouteKey(studentIdAuthKey) {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches(
          '^sid-' + studentIdAuthKey + '(-r[0-9]+)?@students[.]mcsian[.]app$'
        );
    }

    function studentProfileRosterPath(documentId) {
      return /databases/$(database)/documents/webCodeEditor/$(documentId)/studentRoster/$(request.resource.data.rosterDocId);
    }

    function validRosterForStudentProfileCreate(documentId) {
      let rosterPath = studentProfileRosterPath(documentId);

      return request.resource.data.rosterDocId is string
        && request.resource.data.rosterDocId.size() > 0
        && exists(rosterPath)
        && (
          (
            get(rosterPath).data.keys().hasAny(['studentIdNormalized'])
            && get(rosterPath).data.studentIdNormalized == request.resource.data.studentIdNormalized
          )
          || (
            get(rosterPath).data.keys().hasAny(['studentId'])
            && get(rosterPath).data.studentId == request.resource.data.studentId
          )
          || (
            get(rosterPath).data.keys().hasAny(['studentId'])
            && get(rosterPath).data.studentId == request.resource.data.studentIdNormalized
          )
          || (
            get(rosterPath).data.keys().hasAny(['studentIdNormalized'])
            && get(rosterPath).data.studentIdNormalized == request.resource.data.studentId
          )
          || request.resource.data.rosterDocId == request.resource.data.studentIdNormalized
        )
        && !(
          get(rosterPath).data.keys().hasAny(['accountStatus'])
          && get(rosterPath).data.accountStatus == 'disabled'
        );
    }

    function sessionHost(documentId, shareCode) {
      return get(
        /databases/$(database)/documents/webCodeEditor/$(documentId)/sharedSessions/$(shareCode)
      ).data.hostUid;
    }

    match /webCodeEditor/{documentId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();

      match /studentRoster/{studentId} {
        // First activation may read ONLY the exact Student-ID document before
        // Authentication. Full roster queries/listing still require sign-in.
        allow get: if true;
        allow list: if isTeacher() || isSignedIn();
        allow create, update, delete: if isTeacher();
      }

      // STEP 286: minimal login routing.
      // Public can GET only a known Student-ID key; nobody can list the routes.
      // The document contains no password and no project data.
      match /studentLoginRoutes/{studentIdAuthKey} {
        allow get: if true;
        allow list: if isTeacher();

        allow create, update: if isTeacher() || (
          ownsStudentLoginRouteKey(studentIdAuthKey)
          && request.resource.data.studentIdAuthKey == studentIdAuthKey
          && request.resource.data.authEmail == request.auth.token.email
        );

        allow delete: if isTeacher();
      }

      match /students/{studentUid} {
        allow read: if isTeacher() || isOwner(studentUid);

        // v432 — Runaway XP server guard. Once the one-time Explorer XP
        // migration has completed, a student client may keep or lower the
        // stored legacy adjustment, but may never increase it again. This
        // blocks stale/older app versions from repeatedly folding Mini-Game XP
        // into legacyXpAdjustment during background sync. Teacher/admin writes
        // remain exempt so a legitimate repair can still be performed.
        function doesNotIncreaseLockedExplorerLegacyXp() {
          // v454 login-safe runaway-XP guard.
          // A migrated profile may legitimately have NO legacyXpAdjustment.
          // The older guard rejected normal profile updates in that case.
          // This version blocks only an ACTUAL increase of the legacy value.
          return !(
            resource.data.keys().hasAny(['codeExplorerProgress'])
            && resource.data.codeExplorerProgress.keys().hasAny(['xpMigrationVersion'])
            && resource.data.codeExplorerProgress.xpMigrationVersion >= 395
          ) || (
            !request.resource.data.keys().hasAny(['codeExplorerProgress'])
          ) || (
            resource.data.codeExplorerProgress.keys().hasAny(['legacyXpAdjustment'])
            && (
              !request.resource.data.codeExplorerProgress.keys().hasAny(['legacyXpAdjustment'])
              || request.resource.data.codeExplorerProgress.legacyXpAdjustment
                <= resource.data.codeExplorerProgress.legacyXpAdjustment
            )
          ) || (
            !resource.data.codeExplorerProgress.keys().hasAny(['legacyXpAdjustment'])
            && (
              !request.resource.data.codeExplorerProgress.keys().hasAny(['legacyXpAdjustment'])
              || request.resource.data.codeExplorerProgress.legacyXpAdjustment <= 0
            )
          );
        }

        // STEP 284:
        // First-login/profile repair must be tied to the ACTUAL roster document
        // found by the app, not a guessed document path.
        allow create: if isTeacher() || (
          isOwner(studentUid)
          && request.resource.data.studentIdNormalized is string
          && request.resource.data.studentId is string
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.authEmail == request.auth.token.email
          && request.resource.data.accountStatus == 'active'
          && validRosterForStudentProfileCreate(documentId)
        );

        // Lenient profile repair, but only for the signed-in student's own document.
        // Safe Reset Pass is handled by Apps Script; these rules do NOT create new UID/auth accounts.
        // v432 additionally prevents migrated student clients from increasing
        // legacyXpAdjustment, which is a one-time historical value.
        allow update: if isTeacher() || (
          isOwner(studentUid)
          && doesNotIncreaseLockedExplorerLegacyXp()
        );

        allow delete: if isTeacher();

        match /projects/{projectId} {
          allow read, create, update, delete:
            if isTeacher() || isOwner(studentUid);
        }

        // LEGACY STEP 270 Code Inbox kept intact for older already-sent items.
        match /codeInbox/{transferId} {
          allow get, list: if isTeacher() || isOwner(studentUid);

          allow create: if isTeacher() || (
            isSignedIn()
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.receiverUid == studentUid
            && request.resource.data.transferId == transferId
            && request.resource.data.status == 'unread'
            && request.resource.data.fileCount is int
            && request.resource.data.fileCount > 0
            && request.resource.data.fileCount <= 20
            && request.resource.data.createdAtMs is int
          );

          allow update: if isTeacher() || (
            isOwner(studentUid)
            && request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.receiverUid == resource.data.receiverUid
            && request.resource.data.transferId == resource.data.transferId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'readAt', 'readAtMs'
            ])
          );

          allow delete: if isTeacher() || isOwner(studentUid);
        }
      }

      // v429 — XP Mini-Games / Code Explorer leaderboard mirror.
      // Students may write only their own leaderboard row. The XP value must
      // exactly match the post-transaction XP stored in their own student profile.
      // This keeps the Mini-Games reward transaction atomic without exposing
      // other students' leaderboard rows to client-side writes.
      match /codeExplorerLeaderboard/{studentUid} {
        allow get: if isTeacher() || isOwner(studentUid);
        allow list: if isTeacher();

        allow create: if isTeacher() || (
          isOwner(studentUid)
          && request.resource.data.uid == studentUid
          && request.resource.data.keys().hasOnly([
            'uid',
            'studentId',
            'name',
            'section',
            'xp',
            'accountStatus',
            'updatedAt'
          ])
          && request.resource.data.xp is int
          && request.resource.data.xp >= 0
          && request.resource.data.xp == getAfter(
            /databases/$(database)/documents/webCodeEditor/$(documentId)/students/$(studentUid)
          ).data.codeExplorerXp
        );

        allow update: if isTeacher() || (
          isOwner(studentUid)
          && request.resource.data.uid == studentUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid',
            'studentId',
            'name',
            'section',
            'xp',
            'accountStatus',
            'updatedAt'
          ])
          && request.resource.data.xp is int
          && request.resource.data.xp >= 0
          && request.resource.data.xp == getAfter(
            /databases/$(database)/documents/webCodeEditor/$(documentId)/students/$(studentUid)
          ).data.codeExplorerXp
        );

        allow delete: if isTeacher();
      }

      // v447 — XP Mini-Games Weekly Arcade leaderboard.
      // Monday-Sunday standings are stored under a week-start key (YYYY-MM-DD).
      // Students can read the standings, but may write ONLY their own row.
      // Each accepted client update must represent exactly one real reward-sized
      // increment (1..15 XP), so cumulative Today's Game XP or raw game score
      // cannot be copied into the weekly total in a single write.
      match /miniGameWeeklyLeaderboards/{weekKey}/entries/{studentUid} {
        function validMiniGameWeeklyGameId(gameId) {
          return gameId in [
            'code-fly',
            'bug-smash',
            'runner-404',
            'memory-code',
            'code-snake',
            'code-stack',
            'byte-rush',
            'rocket-byte',
            'falling-code',
            'perfect-shot',
            'color-switch-byte',
            'code-hoops',
            'red-light-green-light',
            'code-maze',
            'pattern-lock',
            'code-flow',
            'byte-sling',
            'code-bridge',
            'code-slice',
            'million-byte'
          ];
        }

        function validWeeklyArcadeShape() {
          return request.resource.data.keys().hasOnly([
            'uid',
            'name',
            'section',
            'weekKey',
            'weeklyXp',
            'rewardedSessions',
            'lastRewardGameId',
            'lastRewardXp',
            'accountStatus',
            'lastRewardAt',
            'updatedAt'
          ])
          && request.resource.data.uid == studentUid
          && request.resource.data.weekKey == weekKey
          && weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.section is string
          && request.resource.data.section.size() <= 80
          && request.resource.data.accountStatus is string
          && request.resource.data.weeklyXp is int
          && request.resource.data.weeklyXp > 0
          && request.resource.data.weeklyXp <= 350
          && request.resource.data.rewardedSessions is int
          && request.resource.data.rewardedSessions > 0
          && request.resource.data.rewardedSessions <= 350
          && request.resource.data.lastRewardXp is int
          && request.resource.data.lastRewardXp > 0
          && request.resource.data.lastRewardXp <= 15
          && request.resource.data.lastRewardGameId is string
          && validMiniGameWeeklyGameId(request.resource.data.lastRewardGameId);
        }

        // Students may browse Weekly Arcade standings after login. No email,
        // password, auth route, or project data is stored in these rows.
        allow get, list: if isSignedIn();

        allow create: if isTeacher() || (
          isOwner(studentUid)
          && validWeeklyArcadeShape()
          && request.resource.data.weeklyXp == request.resource.data.lastRewardXp
          && request.resource.data.rewardedSessions == 1
        );

        allow update: if isTeacher() || (
          isOwner(studentUid)
          && validWeeklyArcadeShape()
          && resource.data.uid == studentUid
          && resource.data.weekKey == weekKey
          && request.resource.data.weeklyXp
            == resource.data.weeklyXp + request.resource.data.lastRewardXp
          && request.resource.data.rewardedSessions
            == resource.data.rewardedSessions + 1
        );

        allow delete: if isTeacher();
      }

      // STEP 279: SIMPLE STUDENT-ID CODE INBOX.
      // Sender only needs the receiver's Student ID.
      // Receiver can read only the inbox matching their Firebase student email.
      match /codeInboxesByStudentId/{receiverStudentIdAuthKey}/items/{transferId} {
        allow get, list: if isTeacher()
          || ownsCodeInboxKey(receiverStudentIdAuthKey);

        allow create: if isTeacher() || (
          isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverStudentIdAuthKey == receiverStudentIdAuthKey
          && request.resource.data.transferId == transferId
          && request.resource.data.status == 'unread'
          && request.resource.data.fileCount is int
          && request.resource.data.fileCount > 0
          && request.resource.data.fileCount <= 20
          && request.resource.data.createdAtMs is int
        );

        allow update: if isTeacher() || (
          ownsCodeInboxKey(receiverStudentIdAuthKey)
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.receiverStudentIdAuthKey == resource.data.receiverStudentIdAuthKey
          && request.resource.data.transferId == resource.data.transferId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'readAt', 'readAtMs'
          ])
        );

        allow delete: if isTeacher()
          || ownsCodeInboxKey(receiverStudentIdAuthKey);
      }

      // Full source-code snapshot. New sends use Student-ID ownership.
      // Legacy receiverUid access remains so old transfers are not invalidated.
      match /codeTransfers/{transferId} {
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverStudentIdAuthKey is string
          && request.resource.data.receiverStudentIdAuthKey.size() > 0
          && request.resource.data.fileCount is int
          && request.resource.data.fileCount > 0
          && request.resource.data.fileCount <= 20
          && request.resource.data.totalBytes is int
          && request.resource.data.totalBytes >= 0
          && request.resource.data.totalBytes <= 307200
          && request.resource.data.files is list
          && request.resource.data.files.size() == request.resource.data.fileCount
          && request.resource.data.createdAtMs is int;

        allow get: if isTeacher() || (
          isSignedIn()
          && (
            resource.data.senderUid == request.auth.uid
            || (
              resource.data.receiverStudentIdAuthKey is string
              && ownsCodeInboxKey(resource.data.receiverStudentIdAuthKey)
            )
            || resource.data.receiverUid == request.auth.uid
          )
        );

        allow list: if isTeacher();
        allow update, delete: if isTeacher();
      }

      match /subjectCompliance/{recordId} {
        allow create, update, delete: if isTeacher();

        allow get: if isTeacher() || ownsComplianceRecord(documentId, recordId);
        allow list: if isTeacher();
      }

      match /adminSettings/{settingId} {
        allow read, create, update, delete: if isTeacher();
      }

      // v391 — Public certificate verification + admin legacy backfill.
      // Anyone with the exact certificate number may verify one record, but the
      // collection cannot be listed. Students may publish only certificates
      // already earned in their own Code Explorer progress. The teacher may
      // backfill/update legacy certificate records from the Admin Code Explorer.
      match /publicCertificates/{certificateNumber} {
        function validEarnedCertificate() {
          let student = get(
            /databases/$(database)/documents/webCodeEditor/$(documentId)/students/$(request.auth.uid)
          ).data;
          let course = request.resource.data.courseKey;

          return course in ['html', 'css', 'js']
            && student.name == request.resource.data.studentName
            && student.section == request.resource.data.section
            && student.codeExplorerProgress.courses[course].final.passed == true
            && student.codeExplorerProgress.courses[course].certificate.number == certificateNumber
            && student.codeExplorerProgress.courses[course].certificate.issuedAt == request.resource.data.issuedAt;
        }

        // Exact QR/certificate lookup is public so another phone can verify it.
        allow get: if true;
        // Never expose a browsable list of student certificates.
        allow list: if false;

        allow create: if isTeacher() || (
          isSignedIn()
          && request.resource.data.number == certificateNumber
          && request.resource.data.status == 'valid'
          && request.resource.data.schemaVersion == 1
          && request.resource.data.keys().hasOnly([
            'number', 'courseKey', 'studentName', 'section', 'issuedAt',
            'status', 'schemaVersion', 'publishedAt'
          ])
          && validEarnedCertificate()
        );

        // Students cannot alter issued registry records. Teacher/admin can
        // repair or remove a record when correcting a legacy certificate.
        allow update, delete: if isTeacher();
      }

      match /onlinePresence/{studentUid} {
        allow read: if isTeacher() || isOwner(studentUid);
        allow create, update, delete:
          if isTeacher() || isOwner(studentUid);
      }

      match /sharedSessions/{shareCode} {
        allow get: if isSignedIn();
        allow list: if isTeacher();

        allow create: if isSignedIn()
          && request.resource.data.hostUid == request.auth.uid;

        allow update: if isTeacher() || (
          isSignedIn()
          && resource.data.hostUid == request.auth.uid
        );

        allow delete: if isTeacher() || (
          isSignedIn()
          && resource.data.hostUid == request.auth.uid
        );

        match /peers/{peerUid} {
          allow get: if isTeacher()
            || isOwner(peerUid)
            || (
              isSignedIn()
              && sessionHost(documentId, shareCode) == request.auth.uid
            );

          allow list: if isTeacher()
            || (
              isSignedIn()
              && sessionHost(documentId, shareCode) == request.auth.uid
            );

          allow create: if isOwner(peerUid);

          allow update, delete: if isTeacher()
            || isOwner(peerUid)
            || (
              isSignedIn()
              && sessionHost(documentId, shareCode) == request.auth.uid
            );
        }
      }

      match /submissions/{submissionId} {
        allow create: if isSignedIn()
          && request.resource.data.studentUid == request.auth.uid;

        allow read: if isTeacher()
          || (
            isSignedIn()
            && resource.data.studentUid == request.auth.uid
          );

        allow update, delete: if isTeacher();
      }
    }
  }
}
